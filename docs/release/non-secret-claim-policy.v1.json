{
  "schema": "open-scribe.non-secret-claim-policy/v1",
  "classification": "unauthenticated-structural-claim",
  "admission_effect": "none",
  "scope": "declared command names and file references only",
  "commands": [
    {
      "id": "scaffold",
      "command": "./script/check.sh --scaffold",
      "reference_path": "script/check_scaffold.sh"
    },
    {
      "id": "swift-package",
      "command": "swift test --package-path apps/macos",
      "reference_path": "apps/macos/Package.swift"
    },
    {
      "id": "web-build",
      "command": "./script/build_web.sh",
      "reference_path": "script/build_web.sh"
    },
    {
      "id": "release-inputs",
      "command": "./script/check_release_input_validation.sh",
      "reference_path": "script/check_release_input_validation.sh"
    },
    {
      "id": "release-evidence",
      "command": "./script/check_release_evidence.sh",
      "reference_path": "script/check_release_evidence.sh"
    },
    {
      "id": "release-claim-structure",
      "command": "./script/check_release_claim_structure.sh",
      "reference_path": "script/check_release_claim_structure.sh"
    },
    {
      "id": "bundle-verifier-contract",
      "command": "./script/check_verify_bundle.sh",
      "reference_path": "script/check_verify_bundle.sh"
    },
    {
      "id": "supply-chain-current",
      "command": "./script/generate_supply_chain_manifest.sh --check",
      "reference_path": "script/generate_supply_chain_manifest.sh"
    }
  ],
  "future_execution_design_requirements": [
    "immutable command receipt bytes and independently bound execution authority",
    "repository-derived shipped component and resource graph with unknown-edge rejection",
    "single-snapshot continuity across plan and qualification evaluation",
    "complete candidate command and toolchain denominators",
    "independently established generator runs and canonical notice semantics",
    "repository-root containment across every path component"
  ]
}
